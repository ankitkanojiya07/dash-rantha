{
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build:server && npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{server/dist/**}"
    }
  }
}
