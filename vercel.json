{
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run sync:excel && npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "data/bookings.xlsx"
    }
  }
}
